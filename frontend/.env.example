# Frontend Environment Variables (Production & Staging Template)
# Replace placeholder values with your deployed environment configuration.

# Firebase Public Web Configuration (from Firebase Console -> Project Settings -> General -> Your apps -> Web)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Backend API Base URL (Do NOT use localhost in production)
# In development: http://localhost:8080 (or proxied via Vite)
# In production: https://api.yourdomain.com or https://soho-suite-backend.onrender.com
VITE_API_BASE_URL=https://api.yourdomain.com
