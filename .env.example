# SOHO Suite - Root Deployment Environment Reference
# Refer to frontend/.env.example and backend/.env.example for component-specific configurations.

# --- FRONTEND (Vercel / Netlify / Cloudflare Pages) ---
# VITE_FIREBASE_API_KEY=AIzaSy...
# VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your_project_id
# VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
# VITE_FIREBASE_MESSAGING_SENDER_ID=...
# VITE_FIREBASE_APP_ID=...
# VITE_FIREBASE_MEASUREMENT_ID=...
# VITE_API_BASE_URL=https://soho-suite-api.onrender.com

# --- BACKEND (Render / Railway / Fly.io / GCP Cloud Run) ---
# PORT=8080
# DB_URL=jdbc:postgresql://host:5432/dbname?sslmode=require
# DB_USERNAME=postgres
# DB_PASSWORD=your_secure_password
# FIREBASE_PROJECT_ID=your_project_id
# GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/firebase-service-account.json
# CORS_ALLOWED_ORIGINS=https://soho-suite.vercel.app
