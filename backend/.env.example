# Backend Environment Variables (Production & Staging Template)
# Replace placeholder values with your deployed environment configuration.

# Server Port (provided automatically by Render, Railway, Fly.io, Heroku)
PORT=8080

# Database Configuration (PostgreSQL / Supabase / Neon / Render Postgres)
DB_URL=jdbc:postgresql://your-db-host:5432/your_database_name?sslmode=require
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_secure_password

# Firebase Admin Configuration
FIREBASE_PROJECT_ID=your_project_id
# Absolute path to your service account key JSON on the host
# Example for Render secret files: /etc/secrets/firebase-service-account.json
# Example for Google Cloud (Cloud Run): leave blank to use GCP Application Default Credentials
GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/firebase-service-account.json

# CORS Configuration (Comma-separated list of allowed frontend origins)
# Example: https://soho-suite.vercel.app,https://app.yourdomain.com
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com
